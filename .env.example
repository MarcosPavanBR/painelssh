APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://painel.example.com
APP_NAME=Painel Web
APP_ACCESS_KEY=generate-a-long-random-secret
# 32 raw bytes encoded as base64. Generate with: php -r 'echo base64_encode(random_bytes(32)),PHP_EOL;'
APP_SECRET_KEY=generate-32-byte-base64-key
FORCE_SECURE_COOKIES=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sshplus
DB_USER=painel_app
DB_PASSWORD=generate-a-long-random-password

BACKUP_DIR=/var/backups/painel

# Legacy SMS integrations disabled by default.
CLICKATELL_ENABLED=0
CLICKATELL_USER=
CLICKATELL_PASSWORD=
CLICKATELL_API=
LOCASMS_ENABLED=0
LOCASMS_USER=
LOCASMS_PASSWORD=

# Remote server auto-install is intentionally disabled in V2.
ALLOW_REMOTE_INSTALL=0
